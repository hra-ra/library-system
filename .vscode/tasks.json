{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Build",
      "type": "shell",
      "command": "cmake -S . -B build && cmake --build build -j4",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "2. Create demo data (once)",
      "type": "shell",
      "command": "./build/seed_data",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "1. Build",
      "problemMatcher": []
    },
    {
      "label": "3. Run server (then open http://localhost:18080)",
      "type": "shell",
      "command": "./build/library_server",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "cd build && ctest --output-on-failure",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Preview reminder emails",
      "type": "shell",
      "command": "./build/reminder_job --dry-run",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
